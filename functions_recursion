#factorial of n find krna


def factorial (n):
    fact = 1
    for i in range (1, n+1):
        #1*1->1*2->2*3->6*4
        fact *= i #i mai values hain 1 to n tk ki 
    return fact # yhn return krna zrooi hai wrna None aega

n = int(input("Enter a number: "))
print("Factorial: ", factorial(n))


# #while loop:

def fact_while(n):
    i = 1
    fact = 1
    while i <= n:
     fact *= i
     i+=1
    print(fact)
n = int(input("Enter number: "))
fact_while(n)

